---
// Hero da home: imagem estática do produto, sozinha (LCP).
//
// Fase 9.6 (2026-08-10): o Hero 3D (Three.js) foi removido por decisão do
// Yan — não é retomar experimentação, é alinhar com o que o próprio
// design-dna.json (Fase 3, extraído das fotos reais) já documentava:
// `visual_language.focal_strategy: "single hero element"` e
// `composition.negative_space_role: "protagonista"`. Ver CLAUDE.md.
//
// Remodelagem 2026-08-10 (design-dna.json v2): hierarquia do texto invertida
// — antes o <h1> era literalmente "SOE Acessórios" (o nome da marca, que já
// aparece no Header/Logo) e a proposta de valor ficava rebaixada a parágrafo.
// Agora o <h1> carrega a proposta de valor (o que um heading deve fazer).
//
// Correção 2026-08-10 (rodada real do impeccable, ver PROGRESS.md): a
// primeira versão desta remodelagem colocava um rótulo pequeno em versalete
// acima do <h1> ("SOE Acessórios · Feito à mão de ateliê"). O
// `impeccable detect` (achado real, não hipotético) marcou esse padrão como
// "kicker-above-heading" — um tell de UI gerada por IA, banido mesmo que
// bonito. Removido aqui e nas outras 5 ocorrências do site; a informação que
// o rótulo carregava foi incorporada no parágrafo de apoio abaixo.
import { getCollection } from "astro:content";

const produtos = await getCollection("produtos");
const produtoHero = produtos.find((p) => p.data.destaqueHome) ?? produtos[0];

const imagensDisponiveis = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/produtos/*",
	{ eager: true },
);
const imagemHero = produtoHero
	? imagensDisponiveis[`/src/assets/produtos/${produtoHero.data.imagens[0]}`]?.default
	: undefined;
---

<section class="hero mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-2 md:items-center md:py-24" aria-label="Produto em destaque">
	<div class="hero-copy order-2 flex flex-col gap-4 md:order-1">
		<h1 class="text-carvao-900">
			Acessórios de cabelo artesanais para quem faz questão do detalhe.
		</h1>
		<p class="max-w-sm text-lg text-carvao-700">
			Feito à mão de ateliê: laços em linho bordados um a um, em pequenos lotes.
		</p>
		<a
			href="/catalogo"
			class="mt-2 inline-flex w-fit items-center gap-2 rounded-full bg-dourado-500 px-6 py-3 text-sm font-semibold text-carvao-900 shadow-low transition-shadow hover:shadow-medium"
		>
			Ver catálogo
		</a>
	</div>

	<div class="hero-produto order-1 md:order-2">
		{
			imagemHero && (
				<img
					id="hero-imagem-estatica"
					src={imagemHero.src}
					width={imagemHero.width}
					height={imagemHero.height}
					alt={produtoHero?.data.nome ?? "Produto SOE Acessórios"}
					fetchpriority="high"
					loading="eager"
					decoding="sync"
					class="w-full rounded-3xl bg-creme-300 object-cover shadow-medium"
				/>
			)
		}
	</div>
</section>
