---
import { formatarPreco } from "../../lib/format";

interface Props {
	slug: string;
	nome: string;
	descricaoCurta: string;
	preco: number;
	disponivel: boolean;
	imagemSrc?: string;
	imagemWidth?: number;
	imagemHeight?: number;
	class?: string;
}

const {
	slug,
	nome,
	descricaoCurta,
	preco,
	disponivel,
	imagemSrc,
	imagemWidth,
	imagemHeight,
	class: classeExtra,
} = Astro.props;

// Remodelagem 2026-08-10 (design-dna.json v2, componentes): a referência
// (design-dna-atelieno-referencia.json) mostrou "card sem chrome" — produto
// flutua sobre o fundo, sem borda/sombra/fundo de card ao redor, nome+preço
// alinhados à esquerda abaixo da imagem. Adotado o FORMATO (sombra só no
// hover, sem fundo de card constante), mantendo os cantos arredondados
// (token SOE) e o botão de compra visível — a referência omite botão
// visível no card, mas o CLAUDE.md exige CTA de compra (achado P0 da
// Fase 9), então esse ponto não foi copiado.
---

<li
	class:list={["produto-card group flex flex-col", classeExtra]}
	data-slug={slug}
	data-nome={nome}
	data-preco={preco}
>
	<a href={`/produto/${slug}`} class="flex flex-1 flex-col">
		<div class="aspect-square overflow-hidden rounded-xl bg-creme-300 transition-shadow group-hover:shadow-medium">
			{
				imagemSrc && (
					<img
						src={imagemSrc}
						width={imagemWidth}
						height={imagemHeight}
						alt={nome}
						loading="lazy"
						class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
					/>
				)
			}
		</div>
		<div class="flex flex-1 flex-col gap-1 pt-3">
			<p class="font-heading text-base font-bold text-carvao-900">{nome}</p>
			<p class="line-clamp-2 text-sm text-carvao-700">{descricaoCurta}</p>
			<p class="mt-1 font-heading text-base font-bold text-terracota-700">
				{formatarPreco(preco)}
			</p>
		</div>
	</a>

	<div class="pt-3">
		<button
			type="button"
			class="adicionar-carrinho w-full rounded-full bg-dourado-500 px-4 py-2.5 text-sm font-semibold text-carvao-900 shadow-low transition-shadow hover:shadow-medium disabled:cursor-not-allowed disabled:bg-creme-300 disabled:text-carvao-500 disabled:shadow-none"
			disabled={!disponivel}
		>
			{disponivel ? "Adicionar ao carrinho" : "Indisponível"}
		</button>
	</div>
</li>

<script>
	import { adicionarItem } from "../../lib/cart-store";

	document.querySelectorAll(".adicionar-carrinho").forEach((botao) => {
		botao.addEventListener("click", () => {
			const card = botao.closest(".produto-card");
			if (!(card instanceof HTMLElement)) return;

			const { slug, nome, preco } = card.dataset;
			if (!slug || !nome || !preco) return;

			adicionarItem(slug, nome, Number(preco), 1);

			if (botao instanceof HTMLButtonElement) {
				const textoOriginal = botao.textContent;
				botao.textContent = "Adicionado!";
				botao.disabled = true;
				setTimeout(() => {
					botao.textContent = textoOriginal;
					botao.disabled = false;
				}, 1200);
			}
		});
	});
</script>
