---
import { NUMERO_WHATSAPP_PENDENTE } from "../../lib/config";
---

<aside
	id="cart-drawer"
	hidden
	role="dialog"
	aria-modal="true"
	aria-label="Carrinho de compras"
	data-whatsapp={NUMERO_WHATSAPP_PENDENTE}
	class="fixed inset-y-0 right-0 z-50 flex w-full max-w-sm flex-col gap-4 bg-creme-50 p-6 shadow-high"
>
	<div class="flex items-center justify-between">
		<h2 class="font-heading text-xl font-semibold text-carvao-900">Seu carrinho</h2>
		<button
			id="cart-drawer-fechar"
			type="button"
			aria-label="Fechar carrinho"
			class="flex h-9 w-9 items-center justify-center rounded-full text-carvao-700 transition-colors hover:bg-creme-300 hover:text-carvao-900"
		>
			<svg
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</div>

	<ul id="cart-drawer-itens" class="flex-1 space-y-3 overflow-y-auto text-sm"></ul>

	<div class="space-y-4 border-t border-creme-300 pt-4">
		<p id="cart-drawer-total" class="font-heading text-lg font-semibold text-carvao-900"></p>
		<a
			id="cart-drawer-whatsapp"
			href="#"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center justify-center gap-2 rounded-full bg-dourado-500 px-6 py-3 text-sm font-semibold text-carvao-900 shadow-low transition-shadow hover:shadow-medium"
		>
			Finalizar no WhatsApp
		</a>
	</div>
</aside>

<script>
	import { listarItens, removerItem, gerarMensagemWhatsApp } from "../../lib/cart-store";
	import { formatarPreco } from "../../lib/format";

	const drawer = document.getElementById("cart-drawer");
	const lista = document.getElementById("cart-drawer-itens");
	const totalEl = document.getElementById("cart-drawer-total");
	const linkWhatsApp = document.getElementById("cart-drawer-whatsapp");

	function renderizar() {
		if (!drawer || !lista || !totalEl || !linkWhatsApp) return;

		const itens = listarItens();
		lista.innerHTML = "";

		if (itens.length === 0) {
			const vazio = document.createElement("li");
			vazio.textContent = "Seu carrinho está vazio.";
			vazio.className = "text-carvao-700";
			lista.append(vazio);
		}

		for (const item of itens) {
			const li = document.createElement("li");
			li.className = "flex items-center justify-between gap-3 rounded-xl bg-creme-100 p-3";

			const info = document.createElement("span");
			info.className = "text-carvao-900";
			info.textContent = `${item.quantidade}x ${item.nome}: ${formatarPreco(item.preco * item.quantidade)}`;

			const botaoRemover = document.createElement("button");
			botaoRemover.type = "button";
			botaoRemover.textContent = "Remover";
			botaoRemover.className =
				"shrink-0 text-xs font-medium text-carvao-700 underline decoration-dourado-500 underline-offset-2 hover:text-carvao-900";
			botaoRemover.addEventListener("click", () => removerItem(item.slug));

			li.append(info, botaoRemover);
			lista.append(li);
		}

		const total = itens.reduce((soma, item) => soma + item.preco * item.quantidade, 0);
		totalEl.textContent = `Total: ${formatarPreco(total)}`;

		const numero = drawer.dataset.whatsapp;
		const mensagem = encodeURIComponent(gerarMensagemWhatsApp());
		linkWhatsApp.setAttribute("href", `https://wa.me/${numero}?text=${mensagem}`);
	}

	const botaoFechar = document.getElementById("cart-drawer-fechar");

	// Gestão de foco: ao fechar (por qualquer caminho), devolve o foco pro
	// botão do header que abriu o drawer — achado do audit da Fase 9.
	// Também sincroniza aria-expanded do botão — achado da re-crítica da
	// Fase 9.5 (fechar pelo botão "Fechar"/Esc deixava aria-expanded="true"
	// preso, porque só o próprio clique no ícone zerava esse atributo).
	function fecharDrawer() {
		drawer?.setAttribute("hidden", "");
		const botaoIcone = document.getElementById("cart-icon-toggle");
		botaoIcone?.setAttribute("aria-expanded", "false");
		botaoIcone?.focus();
	}

	botaoFechar?.addEventListener("click", fecharDrawer);

	drawer?.addEventListener("keydown", (evento) => {
		if (evento instanceof KeyboardEvent && evento.key === "Escape") {
			fecharDrawer();
		}
	});

	// Quando o CartIcon abre o drawer, move o foco pra dentro dele (no botão
	// de fechar) — sem isso, um usuário de teclado/leitor de tela não é
	// avisado de que um painel novo apareceu.
	new MutationObserver(() => {
		if (drawer && !drawer.hidden) {
			botaoFechar?.focus();
		}
	}).observe(drawer ?? document.createElement("div"), {
		attributes: true,
		attributeFilter: ["hidden"],
	});

	window.addEventListener("soe-carrinho-atualizado", renderizar);
	renderizar();
</script>
