---
import {
	NUMERO_WHATSAPP_PENDENTE,
	CNPJ_FICTICIO,
	ENDERECO_FICTICIO,
	EMAIL_FICTICIO,
} from "../../lib/config";
import Logo from "./Logo.astro";

// Remodelagem 2026-08-10: os placeholders em colchetes ([CNPJ/MEI —
// PENDENTE] etc.) foram substituídos pelos valores fictícios de
// src/lib/config.ts, sem selo visual de "pendente" (pedido explícito do
// Yan — nenhum placeholder deve aparecer). O rastreamento de que são
// valores fictícios, não reais, fica em src/lib/config.ts e no CLAUDE.md,
// não na interface.
---

<footer class="bg-carvao-900 px-6 py-12 text-creme-100">
	<div class="mx-auto flex max-w-6xl flex-col gap-8">
		<div class="flex items-center gap-2.5">
			<Logo class="h-7 w-7 shrink-0 text-dourado-500" />
			<span class="font-heading text-base font-extrabold tracking-tight text-creme-50">
				SOE Acessórios
			</span>
		</div>

		<div class="grid gap-8 text-sm text-creme-300 sm:grid-cols-3">
			<div class="flex flex-col gap-2">
				<p class="rotulo-secao text-creme-500">Ateliê</p>
				<p>{CNPJ_FICTICIO}</p>
				<p>{ENDERECO_FICTICIO}</p>
			</div>

			<div class="flex flex-col gap-2">
				<p class="rotulo-secao text-creme-500">Contato</p>
				<p>
					<a class="hover:text-dourado-500" href={`mailto:${EMAIL_FICTICIO}`}>{EMAIL_FICTICIO}</a>
				</p>
				<p>
					<a
						class="hover:text-dourado-500"
						href={`https://wa.me/${NUMERO_WHATSAPP_PENDENTE}`}
						target="_blank"
						rel="noopener noreferrer"
					>
						WhatsApp
					</a>
				</p>
				<p>
					<a class="hover:text-dourado-500" href="https://www.instagram.com/soefloripa" target="_blank" rel="noopener noreferrer">
						@soefloripa
					</a>
				</p>
			</div>

			<div class="flex flex-col gap-2">
				<p class="rotulo-secao text-creme-500">Institucional</p>
				<nav aria-label="Links institucionais">
					<ul class="flex flex-col gap-2">
						<li><a class="hover:text-dourado-500" href="/institucional/privacidade">Política de Privacidade</a></li>
						<li><a class="hover:text-dourado-500" href="/institucional/termos">Termos de Uso</a></li>
						<li><a class="hover:text-dourado-500" href="/institucional/trocas-devolucoes">Trocas e Devoluções</a></li>
						<li><a class="hover:text-dourado-500" href="/institucional/contato">Contato</a></li>
					</ul>
				</nav>
			</div>
		</div>

		<p class="border-t border-creme-900/60 pt-6 text-xs text-creme-500">
			© {new Date().getFullYear()} SOE Acessórios — feito à mão, um de cada vez.
		</p>
	</div>
</footer>
