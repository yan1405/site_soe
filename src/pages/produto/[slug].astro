---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { NUMERO_WHATSAPP_PENDENTE } from "../../lib/config";

export async function getStaticPaths() {
	const produtos = await getCollection("produtos");
	return produtos.map((produto) => ({
		params: { slug: produto.id },
		props: { produto },
	}));
}

const { produto } = Astro.props;
const { Content } = await render(produto);

const imagensDisponiveis = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/produtos/*",
	{ eager: true },
);

function resolverImagem(nomeArquivo: string) {
	return imagensDisponiveis[`/src/assets/produtos/${nomeArquivo}`]?.default;
}

const mensagemWhatsApp = encodeURIComponent(
	`Olá! Tenho interesse no ${produto.data.nome}, vi no site.`,
);
---

<BaseLayout title={produto.data.nome}>
	<div class="mx-auto grid max-w-5xl gap-10 px-6 py-16 md:grid-cols-2">
		<div class="flex flex-col gap-4">
			{
				produto.data.imagens.map((nomeArquivo) => {
					const imagem = resolverImagem(nomeArquivo);
					return (
						imagem && (
							<img
								src={imagem.src}
								width={imagem.width}
								height={imagem.height}
								alt={produto.data.nome}
								class="w-full rounded-xl bg-creme-300 object-cover shadow-low"
							/>
						)
					);
				})
			}
		</div>

		<div class="flex flex-col gap-4">
			<h1 class="text-carvao-900">{produto.data.nome}</h1>
			<p class="font-heading text-2xl font-semibold text-carvao-900">
				R$ {produto.data.preco.toFixed(2)}
			</p>
			<p class="text-carvao-700">{produto.data.descricaoCurta}</p>
			<p class="text-sm font-medium text-oliva-700">
				{produto.data.disponivel ? "Disponível" : "Indisponível no momento"}
			</p>

			<div class="prose-conteudo text-carvao-700">
				<Content />
			</div>

			<div
				class="produto-cta mt-2 flex flex-col gap-3"
				data-slug={produto.id}
				data-nome={produto.data.nome}
				data-preco={produto.data.preco}
			>
				<button
					type="button"
					class="adicionar-carrinho-produto w-full rounded-full bg-dourado-500 px-6 py-3 text-sm font-semibold text-carvao-900 shadow-low transition-shadow hover:shadow-medium disabled:cursor-not-allowed disabled:bg-creme-300 disabled:text-carvao-500 disabled:shadow-none sm:w-auto"
					disabled={!produto.data.disponivel}
				>
					{produto.data.disponivel ? "Adicionar ao carrinho" : "Indisponível"}
				</button>

				<a
					href={`https://wa.me/${NUMERO_WHATSAPP_PENDENTE}?text=${mensagemWhatsApp}`}
					target="_blank"
					rel="noopener noreferrer"
					class="text-sm font-medium text-carvao-700 underline decoration-dourado-500 underline-offset-4 hover:text-carvao-900"
				>
					Prefere falar direto? Chame no WhatsApp
				</a>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	import { adicionarItem } from "../../lib/cart-store";

	document.querySelectorAll(".adicionar-carrinho-produto").forEach((botao) => {
		botao.addEventListener("click", () => {
			const bloco = botao.closest(".produto-cta");
			if (!(bloco instanceof HTMLElement)) return;

			const { slug, nome, preco } = bloco.dataset;
			if (!slug || !nome || !preco) return;

			adicionarItem(slug, nome, Number(preco), 1);

			if (botao instanceof HTMLButtonElement) {
				const textoOriginal = botao.textContent;
				botao.textContent = "Adicionado!";
				botao.disabled = true;
				setTimeout(() => {
					botao.textContent = textoOriginal;
					botao.disabled = false;
				}, 1200);
			}
		});
	});
</script>
