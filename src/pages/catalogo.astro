---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const produtos = await getCollection("produtos");

// Resolve os arquivos em src/assets/produtos/ referenciados pelo campo `imagens`
// de cada entrada (ainda sem componente <Image />/estilização — Fase 2 é só dados).
const imagensDisponiveis = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/produtos/*",
	{ eager: true },
);

function resolverImagem(nomeArquivo: string) {
	return imagensDisponiveis[`/src/assets/produtos/${nomeArquivo}`]?.default;
}
---

<BaseLayout title="Catálogo">
	<h1>Catálogo</h1>

	<ul>
		{
			produtos.map((produto) => {
				const imagem = resolverImagem(produto.data.imagens[0]);
				return (
					<li>
						<a href={`/produto/${produto.id}`}>
							{imagem && (
								<img
									src={imagem.src}
									width={imagem.width}
									height={imagem.height}
									alt={produto.data.nome}
								/>
							)}
							<p>{produto.data.nome}</p>
							<p>{produto.data.descricaoCurta}</p>
							<p>R$ {produto.data.preco.toFixed(2)}</p>
							<p>{produto.data.disponivel ? "Disponível" : "Indisponível"}</p>
						</a>
					</li>
				);
			})
		}
	</ul>
</BaseLayout>
